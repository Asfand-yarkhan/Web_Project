<script>
	(function () {
		var grid = document.getElementById('testimonialsGrid');
		var btn = document.getElementById('testimonialsToggle');
		if (!grid || !btn) return;
		var cards = Array.prototype.slice.call(grid.querySelectorAll('.testimonial-card'));
		function showFirstThree() {
			cards.forEach(function (card, idx) { card.classList.toggle('hidden', idx >= 3); });
			btn.textContent = 'View More';
			btn.setAttribute('data-state', 'collapsed');
		}
		function showAll() {
			cards.forEach(function (card) { card.classList.remove('hidden'); });
			btn.textContent = 'View Less';
			btn.setAttribute('data-state', 'expanded');
		}
		// Init: show exactly 3
		showFirstThree();
		btn.addEventListener('click', function (e) {
			e.preventDefault();
			var state = btn.getAttribute('data-state');
			if (state === 'collapsed') showAll(); else showFirstThree();
		});
	})();
</script>

