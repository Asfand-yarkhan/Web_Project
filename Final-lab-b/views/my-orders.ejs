<!DOCTYPE html>
<html lang="en">

<head>
          <meta charset="UTF-8">
          <title>My Orders</title>
          <style>
                    body {
                              font-family: 'Outfit', sans-serif;
                              background: #0f172a;
                              color: white;
                              padding: 2rem;
                    }

                    .container {
                              max-width: 800px;
                              margin: auto;
                    }

                    .search-box {
                              background: rgba(255, 255, 255, 0.1);
                              padding: 2rem;
                              border-radius: 15px;
                              margin-bottom: 2rem;
                              text-align: center;
                    }

                    .order-card {
                              background: rgba(255, 255, 255, 0.05);
                              padding: 1.5rem;
                              border-radius: 10px;
                              margin-bottom: 1rem;
                              border-left: 5px solid #6366f1;
                    }

                    input {
                              padding: 10px;
                              width: 300px;
                              border-radius: 5px;
                              border: none;
                    }

                    .btn {
                              padding: 10px 20px;
                              background: #6366f1;
                              color: white;
                              border: none;
                              border-radius: 5px;
                              cursor: pointer;
                    }

                    .status-badge {
                              float: right;
                              padding: 5px 12px;
                              border-radius: 20px;
                              font-size: 0.8rem;
                              background: #1e293b;
                    }
          </style>
</head>

<body>
          <div class="container">
                    <h1>Customer Order History</h1>

                    <div class="search-box">
                              <form action="/order/my-orders/search" method="POST">
                                        <input type="email" name="email" placeholder="Enter your email to see orders"
                                                  required value="<%= typeof email !== 'undefined' ? email : '' %>">
                                        <button type="submit" class="btn">Search Orders</button>
                              </form>
                    </div>

                    <% if (orders && orders.length> 0) { %>
                              <% orders.forEach(order=> { %>
                                        <div class="order-card">
                                                  <span class="status-badge">
                                                            <%= order.status %>
                                                  </span>
                                                  <h3>Order #<%= order._id %>
                                                  </h3>
                                                  <p>Date: <%= order.createdAt.toDateString() %>
                                                  </p>
                                                  <p>Items: <%= order.items.length %>
                                                  </p>
                                                  <p>Total Paid: <strong>$<%= order.finalAmount %></strong></p>
                                        </div>
                                        <% }) %>
                                                  <% } else if (orders) { %>
                                                            <div
                                                                      style="text-align: center; background: rgba(239, 68, 68, 0.1); padding: 2rem; border-radius: 10px;">
                                                                      <p>No orders found for <strong>
                                                                                          <%= email %>
                                                                                </strong>.</p>
                                                                      <p style="font-size: 0.9rem; color: #94a3b8;">Tip:
                                                                                Order history sirf tab banti hai jab aap
                                                                                checkout confirm krte hain. <br> Pehle
                                                                                "Product Manager" mein ja kr kisi item
                                                                                pr <strong>"Buy Now"</strong> click
                                                                                karein aur apna email enter kr ke order
                                                                                finish karein.</p>
                                                            </div>
                                                            <% } %>

                                                                      <p style="text-align: center;"><a href="/"
                                                                                          style="color: grey;">Back to
                                                                                          Home</a></p>
          </div>
</body>

</html>