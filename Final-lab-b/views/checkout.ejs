        <h2>Checkout</h2>
        <div class="grid cols-2">
          <div class="card">
            <div class="pad">
              <h3 style="margin-top:0;">Billing details</h3>
              <form id="checkoutForm" action="/signup" method="POST">
                <div class="row">
                  <div>
                    <label for="firstName">First name</label>
                    <input id="firstName" name="firstName" type="text" placeholder="John" required>
                    <div class="error" data-error-for="firstName"></div>
                  </div>
                  <div>
                    <label for="lastName">Last name</label>
                    <input id="lastName" name="lastName" type="text" placeholder="Doe" required>
                    <div class="error" data-error-for="lastName"></div>
                  </div>
                </div>
                <label for="email">Email</label>
                <input id="email" name="email" type="email" placeholder="john@example.com" required>
                <div class="error" data-error-for="email"></div>
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" placeholder="+61 383 766 284" required>
                <div class="error" data-error-for="phone"></div>
                <label for="address">Address</label>
                <input id="address" name="address" type="text" placeholder="Street, number">
                <div class="error" data-error-for="address"></div>
                <div class="row">
                  <div>
                    <label for="city">City</label>
                    <input id="city" name="city" type="text" placeholder="Melbourne">
                    <div class="error" data-error-for="city"></div>
                  </div>
                  <div>
                    <label for="zip">ZIP</label>
                    <input id="zip" name="zip" type="text" placeholder="3000">
                    <div class="error" data-error-for="zip"></div>
                  </div>
                </div>
                <h3>Payment</h3>
                <div class="row">
                  <div>
                    <label for="cardNumber">Card number</label>
                    <input id="cardNumber" type="text" placeholder="1234 5678 9012 3456">
                    <div class="error" data-error-for="cardNumber"></div>
                  </div>
                  <div>
                    <label for="cardName">Name on card</label>
                    <input id="cardName" type="text" placeholder="John Doe">
                    <div class="error" data-error-for="cardName"></div>
                  </div>
                </div>
                <div class="row">
                  <div>
                    <label for="expiry">Expiry</label>
                    <input id="expiry" type="text" placeholder="MM/YY">
                    <div class="error" data-error-for="expiry"></div>
                  </div>
                  <div>
                    <label for="cvv">CVV</label>
                    <input id="cvv" type="text" placeholder="123">
                    <div class="error" data-error-for="cvv"></div>
                  </div>
                </div>
                <button class="button" type="submit" style="margin-top:12px;">Place order</button>
              </form>
