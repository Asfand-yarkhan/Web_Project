</body>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  (function ($) {
    function setError(id, message) {
      var $input = $('#' + id);
      $input.addClass('invalid');
      $('[data-error-for="' + id + '"]').text(message || '');
    }
    function clearError(id) {
      var $input = $('#' + id);
      $input.removeClass('invalid');
      $('[data-error-for="' + id + '"]').text('');
    }
    function luhnCheck(number) {
      var str = (number || '').replace(/\D/g, '');
      var sum = 0, alt = false;
      for (var i = str.length - 1; i >= 0; i--) {
        var n = parseInt(str.charAt(i), 10);
        if (alt) { n *= 2; if (n > 9) n -= 9; }
        sum += n; alt = !alt;
      }
      return str.length >= 13 && sum % 10 === 0;
    }
    function isFutureExpiry(mmYY) {
      var m = mmYY.match(/^(0[1-9]|1[0-2])\/(\d{2})$/);
      if (!m) return false;
      var month = parseInt(m[1], 10);
      var year = 2000 + parseInt(m[2], 10);
      var now = new Date();
      var exp = new Date(year, month);
      return exp > now;
    }
    $('#checkoutForm').on('submit', function (e) {
      e.preventDefault();
      var ok = true;
      var fields = ['firstName', 'lastName', 'email', 'phone', 'address', 'city', 'zip', 'cardNumber', 'cardName', 'expiry', 'cvv'];
      fields.forEach(function (id) { clearError(id); });

      function requireText(id, label) {
        var v = $.trim($('#' + id).val());
        if (!v) { setError(id, label + ' is required'); ok = false; }
        return v;
      }
      var first = requireText('firstName', 'First name');
      var last = requireText('lastName', 'Last name');
      var email = requireText('email', 'Email');
      var phone = requireText('phone', 'Phone');
      var address = requireText('address', 'Address');
      var city = requireText('city', 'City');
      var zip = requireText('zip', 'ZIP');
      var cardNumber = requireText('cardNumber', 'Card number');
      var cardName = requireText('cardName', 'Name on card');
      var expiry = requireText('expiry', 'Expiry');
      var cvv = requireText('cvv', 'CVV');

      if (email && !/^\S+@\S+\.\S+$/.test(email)) { setError('email', 'Enter a valid email'); ok = false; }
      if (phone && !/^[+\d][\d\s-]{6,}$/.test(phone)) { setError('phone', 'Enter a valid phone'); ok = false; }
      if (zip && !/^\d{3,10}$/.test(zip)) { setError('zip', 'ZIP must be numeric'); ok = false; }
      if (cardNumber && !luhnCheck(cardNumber)) { setError('cardNumber', 'Invalid card number'); ok = false; }
      if (expiry && !isFutureExpiry(expiry)) { setError('expiry', 'Invalid expiry (MM/YY)'); ok = false; }
      if (cvv && !/^\d{3,4}$/.test(cvv)) { setError('cvv', 'CVV must be 3 or 4 digits'); ok = false; }

      if (ok) {
        // Now submit the form genuinely to the server
        this.submit();
      }
    });
  })(jQuery);
</script>
<script>
  // Search toggle
  document.getElementById('search_button').addEventListener('click', function (e) {
